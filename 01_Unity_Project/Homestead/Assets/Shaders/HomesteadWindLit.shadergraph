        {
            "m_Id": "766add640b20488ca730f51508612404"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "HomesteadWindSway",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Homestead wind (2026-11-19): bends the plant downwind, more with height (quadratic, so the base stays planted),\n// in slow gusting waves whose phase changes across the land, plus a small quick flutter for leaves.\n// Wind: x,y = the direction the wind blows TOWARD on the ground (world X, Z), z = strength 0-1 (WeatherManager.WindStrength).\nfloat3 pivotWS = GetAbsolutePositionWS(TransformObjectToWorld(float3(0, 0, 0)));\nfloat t = _TimeParameters.x;\nfloat strength = Wind.z;\nfloat phase = dot(pivotWS.xz, float2(0.071, 0.053));\nfloat h = max(PositionOS.y, 0) / max(Height, 0.001);\nfloat bend = h * h;\nfloat gust = 0.65 + 0.35 * sin(t * 0.31 + phase * 0.7);\nfloat wave = sin(t * (0.9 + 0.9 * strength) + phase) * 0.55 + sin(t * 2.17 + phase * 1.9) * 0.2;\nfloat lean = (0.35 + 0.65 * strength) * strength;\nfloat amount = (lean + wave * (0.25 + strength)) * gust * Sway * bend;\nfloat3 dirWS = float3(Wind.x, 0, Wind.y);\nfloat3 dirOS = TransformWorldToObjectDir(dirWS, true);\nfloat3 offset = dirOS * amount;\noffset.y -= abs(amount) * amount * 0.35 / max(Height, 0.001);\nfloat fl = sin(t * 7.3 + dot(PositionOS, float3(5.1, 3.7, 4.3)) + phase * 3.0) * Flutter * (0.25 + strength) * saturate(h * 1.5);\noffset += float3(fl, fl * 0.4, -fl * 0.7);\nOut = PositionOS + offset;\n"
}

