{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "27b51f34f9a3451aadca552b07c6100b",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "HomesteadWaterSurface (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -400,
            "y": -200,
            "width": 180,
            "height": 80
        }
    },
    "m_Slots": [
        {
            "m_Id": "09eb815e42594685a0e2ff437e65e07c"
        },
        {
            "m_Id": "8fe424af6e6447cdb9076839cb973cc8"
        },
        {
            "m_Id": "995540af885445588d3cedbde2ebc64d"
        },
        {
            "m_Id": "b7ce1c5abc9a408a8d0379f95fec942f"
        },
        {
            "m_Id": "6e81b1b3d8334550ac3ff3b2ce0f9793"
        },
        {
            "m_Id": "9459daedc08c46e1a3b57688f31f693a"
        },
        {
            "m_Id": "5db3f213eada49f1aef1ed0750be5627"
        },
        {
            "m_Id": "712919520ee445ca8a54c0b3da1d21fa"
        },
        {
            "m_Id": "66f50eaf65d14f49bb1683f1b73a0c5d"
        },
        {
            "m_Id": "2f99acffaf7a479da0aa6023d1277829"
        },
        {
            "m_Id": "f77a1d2784624746a1dc3af7e71ec6e5"
        },
        {
            "m_Id": "74b954e2592c4ab392f3b4000af65808"
        },
        {
            "m_Id": "59e4d41e55cd4d8e930edcf112f3a735"
        },
        {
            "m_Id": "b4c2371c81094f2c8af2f9f0f54fa5ad"
        },
        {
            "m_Id": "1193c8b147ad4d758dc8189b3506d342"
        },
        {
            "m_Id": "1f7c17d190c34325b3b61ea1eeb584ab"
        },
        {
            "m_Id": "1295b2e7e36844d7a2129ed7b8302ad7"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "HomesteadWaterSurface",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Homestead water (2026-11-19): see-through creek and pond water, clear in the shallows and darker with depth (from the\n// scene depth behind the surface), ripples carried downstream by the flow the mesh stores in UV1 (x, z direction,\n// z = speed m/s) with two-phase flow mapping so they never stretch, a slower cross ripple from the wind, and foam\n// where the water thins against the bank.\nfloat3 posRel = GetCameraRelativePositionWS(PosWS);\nfloat surfaceEye = -TransformWorldToView(posRel).z;\nfloat thick = max(0.0, SceneEye - surfaceEye);\nfloat t = _TimeParameters.x;\nfloat2 flowUV = Flow.xy * Flow.z * FlowSpeed / max(RippleScale, 0.01);\nconst float period = 3.0;\nfloat ph0 = frac(t / period);\nfloat ph1 = frac(t / period + 0.5);\nfloat w0 = 1.0 - abs(ph0 * 2.0 - 1.0);\nfloat2 uv = PosWS.xz / max(RippleScale, 0.01);\nfloat4 r0 = SAMPLE_TEXTURE2D(Ripple.tex, Ripple.samplerstate, uv - flowUV * ph0 * period);\nfloat4 r1 = SAMPLE_TEXTURE2D(Ripple.tex, Ripple.samplerstate, uv + 0.37 - flowUV * ph1 * period);\nfloat4 r2 = SAMPLE_TEXTURE2D(Ripple.tex, Ripple.samplerstate, uv * 0.41 + float2(t * 0.011, -t * 0.007));\nfloat2 n0 = r0.xy * 2.0 - 1.0, n1 = r1.xy * 2.0 - 1.0, n2 = r2.xy * 2.0 - 1.0;\nfloat2 nxy = (lerp(n1, n0, w0) + n2 * 0.6) * RippleStrength;\nNormalWS = normalize(float3(nxy.x, 1.0, nxy.y));\nfloat deep = saturate(thick / max(Clarity, 0.01));\nColor = lerp(Shallow.rgb, Deep.rgb, deep);\nAlpha = lerp(0.2, 0.93, saturate(thick / max(Clarity * 0.6, 0.01)));\nfloat foamTex = SAMPLE_TEXTURE2D(FoamMap.tex, FoamMap.samplerstate, uv * 1.7 - flowUV * t * 0.25).r;\nfloat edge = saturate(1.0 - thick / max(FoamWidth, 0.001));\nfloat foam = saturate((edge * 1.4 - (1.0 - foamTex)) * 2.0) * step(0.001, thick);\nColor = lerp(Color, float3(0.62, 0.63, 0.6), foam * 0.85);\nAlpha = max(Alpha, foam * 0.85);\nGloss = lerp(Smooth, 0.35, foam);\n"
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.Internal.Texture2DShaderProperty",
    "m_ObjectId": "6c06f674e9be4030ad60c9640d446e6c",
    "m_Guid": {
        "m_GuidSerialized": "5de9406d-c7d1-4f30-8b25-4235e923aae7"
